# שלב 1: בחירת אימג' בסיס רשמי של Python
# שימוש בגרסה ספציפית מבטיח יציבות. גרסת slim קטנה יותר.
FROM python:3.10-slim

# שלב 2: הגדרת משתני סביבה
# מונע מפייתון ליצור קבצי .pyc ולכתוב לפלט לפני שהתהליך מסתיים
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# שלב 3: הגדרת תיקיית העבודה בתוך הקונטיינר
WORKDIR /app

# שלב 4: התקנת תלויות
# העתקת קובץ הדרישות בלבד והתקנתו. Docker ישמור את השכבה הזו במטמון
# כל עוד הקובץ לא משתנה, מה שמזרז בניות עתידיות.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# שלב 5: העתקת קוד המקור של הפרויקט
COPY . .

# שלב 6: חשיפת פורט הדשבורד
EXPOSE 8501

# שלב 7: הגדרת הפקודה שתרוץ כשהקונטיינר יופעל
CMD ["python", "main.py"]
