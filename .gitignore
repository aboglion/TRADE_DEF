# --- Environment & Credentials ---
# התעלם מקובץ .env המכיל סיסמאות ופרטים רגישים. חובה.
.env

# --- Python ---
# התעלם מקבצים ותיקיות שפייתון יוצר אוטומטית בזמן ריצה.
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Project-specific Logs ---
# התעלם מתיקיית הלוגים שהפרויקט יוצר.
LOGS/

# --- Common IDE & OS files ---
# התעלם מקבצים של סביבות פיתוח ומערכות הפעלה.
# מונע "זבל" במאגר הקוד.
.idea/
.vscode/
.DS_Store